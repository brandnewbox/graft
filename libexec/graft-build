#!/usr/bin/env bash
# graft build: builds the app in the current directory for the phone. graft runs it in the
# container, at the project's root.
#
#   graft-build [--configuration NAME | --release] [TARGET]
#
# NAME is the build configuration (default Debug; --release is Release). Debug builds a SwiftPM
# debug build, every other configuration a release build.
#
# An xtool package (xtool.yml here, and no project: or target: in graft.yml) builds as it is. An
# Xcode project gets an xtool adapter first, made by the converter (graft's copy,
# vendor/omarchy-apple-dev) into .graft/<TARGET>/<NAME> on every build, so it follows the project.
# graft.yml, every key optional:
#   xcode: 27.1               the Xcode to build with (graft reads it, to pick the toolchain)
#   project: App.xcodeproj    the Xcode project (default: the only one here)
#   target: App               the app target (default: the project's only one)
# Writes the .app's path to GRAFT_APP_FILE when that is set (graft-deploy reads it).
set -euo pipefail
configuration=Debug target=
while [ $# -gt 0 ]; do
  case "$1" in
    --release) configuration=Release ;;
    --configuration) configuration=${2:?--configuration needs a name}; shift ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) [ -z "$target" ] || { echo "usage: graft build [--configuration NAME | --release] [TARGET]" >&2; exit 2; }; target=$1 ;;
  esac
  shift
done
mode=release
if [ "$configuration" = Debug ]; then mode=debug; fi
O=$HOME/omarchy-apple-dev
converter=$O/tools/xcodeproj2xtool.py

# graft setup makes the SDK; without it the build fails deep in SwiftPM.
if [ ! -d "$HOME/.swiftpm/swift-sdks/darwin.artifactbundle" ]; then
  echo "No iOS SDK for Xcode $GRAFT_XCODE on this machine. Download Xcode $GRAFT_XCODE's .xip from" >&2
  echo "https://developer.apple.com/download/all/?q=Xcode, then: graft setup Xcode_$GRAFT_XCODE.xip" >&2
  exit 1
fi

setting() { # graft.yml's value for KEY, without quotes or a comment
  [ -f graft.yml ] || return 0
  sed -n "s/^$1:[[:space:]]*//p" graft.yml | sed -e 's/[[:space:]]*#.*$//' -e "s/^[\"']//" -e "s/[\"']\$//" | head -n1
}

if [ -f xtool.yml ] && [ -z "$(setting project)$(setting target)" ]; then
  [ -z "$target" ] || { echo "an xtool package has one app: no TARGET" >&2; exit 2; }
  dir=.
else
  project=$(setting project)
  if [ -z "$project" ]; then
    mapfile -t found < <(find . -maxdepth 3 \( -name .graft -o -name Pods -o -name node_modules \) -prune -o \
      -name '*.xcodeproj' -print | sed 's|^\./||' | sort)
    [ "${#found[@]}" = 1 ] ||
      { echo "${#found[@]} Xcode projects here: name one in graft.yml (project: ...), or run graft at the project's root" >&2; exit 1; }
    project=${found[0]}
  fi
  log=$(mktemp)
  trap 'rm -rf "$log" "${new:-}"' EXIT
  target=${target:-$(setting target)}
  if [ -z "$target" ]; then
    target=$(python3 "$converter" "$project" --print-target 2>"$log") ||
      { sed 's/pass --target NAME/name one (graft build TARGET, or target: in graft.yml)/' "$log" >&2; exit 1; }
  fi
  dir=.graft/$target/$configuration
  mkdir -p .graft
  [ -f .graft/.gitignore ] || echo '*' >.graft/.gitignore
  # The converter's links are relative, so the new adapter is made beside $dir, at its depth. Only
  # files that changed are copied over it, and what the build writes stays (the build tree,
  # Package.resolved), so the build stays incremental.
  new=$(dirname "$dir")/.$configuration.new
  rm -rf "$new"
  mkdir -p "$(dirname "$dir")"
  echo "== Adapter for $target ($configuration) of $project =="
  python3 "$converter" "$project" --target "$target" --configuration "$configuration" --no-bsp --out "$new" |
    { grep -v '^wrote ' || true; }
  mkdir -p "$dir"
  rsync -rlpD --checksum --delete \
    --exclude /.build --exclude /.swiftpm --exclude /.bsp --exclude /xtool \
    --exclude /Package.resolved --exclude /.xcode-resolved \
    "$new/" "$dir/"
  rm -rf "$new"
  # The package versions Xcode resolved, so this build gets the same ones. Copied when the project's
  # Package.resolved changes; in between, SwiftPM keeps the adapter's.
  resolved=$project/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
  if [ -f "$resolved" ] && ! cmp -s "$resolved" "$dir/.xcode-resolved"; then
    cp "$resolved" "$dir/Package.resolved"
    cp "$resolved" "$dir/.xcode-resolved"
  fi
fi

# ship.sh --device rather than xtool dev build: it puts the resources at the bundle root, where
# Bundle.main finds them, as Xcode lays an app out.
echo "== Build ($configuration) =="
(cd "$dir" && CONFIGURATION=$mode "$O/ship.sh" --device)
app=$(ls -dt "$dir"/xtool/*.app | head -n1)
app=${app#./}
echo "Built $app"
if [ -n "${GRAFT_APP_FILE:-}" ]; then realpath "$app" >"$GRAFT_APP_FILE"; fi
