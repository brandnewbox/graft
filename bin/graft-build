#!/usr/bin/env bash
# graft build and graft convert. The launcher runs them in the container, at the project's root.
#
#   graft-build [--configuration NAME | --release] [TARGET]     build the app for the phone
#   graft-convert [--configuration NAME | --release] [TARGET]   make an Xcode project's adapter
#
# NAME is the build configuration (default Debug; --release is Release). Debug builds a SwiftPM
# debug build, every other configuration a release build.
#
# An xtool package (xtool.yml here, no graft.yml) builds as it is. An Xcode project builds through
# an adapter, an xtool package that graft convert makes with the converter (converter/ in graft's
# repository) in <adapters>/<TARGET>/<NAME>, for the project to commit. Edits to it stay until the
# next convert. Its .graft-converted holds a hash of what the converter wrote; graft build converts
# again into a scratch directory, and stops when the hash differs: the project changed since. graft.yml,
# every key optional:
#   project: App.xcodeproj    the Xcode project (default: the only one here)
#   target: App               the app target (default: the project's only one)
#   adapters: graft           where the adapters go (default: graft)
# Writes the .app's path to GRAFT_APP_FILE when that is set (graft-deploy reads it).
set -euo pipefail
configuration=Debug target=
while [ $# -gt 0 ]; do
  case "$1" in
    --release) configuration=Release ;;
    --configuration) configuration=${2:?--configuration needs a name}; shift ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) [ -z "$target" ] || { echo "usage: graft build [--configuration NAME | --release] [TARGET]" >&2; exit 2; }; target=$1 ;;
  esac
  shift
done
convert_only=${GRAFT_CONVERT_ONLY:-}
mode=release
if [ "$configuration" = Debug ]; then mode=debug; fi
O=$HOME/omarchy-apple-dev
converter=$O/tools/xcodeproj2xtool.py

setting() { # graft.yml's value for KEY, without quotes or a comment
  [ -f graft.yml ] || return 0
  sed -n "s/^$1:[[:space:]]*//p" graft.yml | sed -e 's/[[:space:]]*#.*$//' -e "s/^[\"']//" -e "s/[\"']\$//" | head -n1
}

# A hash of an adapter as the converter wrote it: names, link targets, contents and modes.
tree_hash() {
  tar -C "$1" --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --mode=u+rw,go-w,a+rX -cf - . |
    sha256sum | cut -d' ' -f1
}

if [ -f xtool.yml ] && [ ! -f graft.yml ]; then
  [ -z "$convert_only" ] || { echo "an xtool package builds as it is: nothing to convert" >&2; exit 2; }
  [ -z "$target" ] || { echo "an xtool package has one app: no TARGET" >&2; exit 2; }
  dir=.
else
  project=$(setting project)
  if [ -z "$project" ]; then
    mapfile -t found < <(find . -maxdepth 3 \( -name Pods -o -name node_modules \) -prune -o \
      -name '*.xcodeproj' -print | sed 's|^\./||' | sort)
    [ "${#found[@]}" = 1 ] ||
      { echo "${#found[@]} Xcode projects here: name one in graft.yml (project: ...), or run graft at the project's root" >&2; exit 1; }
    project=${found[0]}
  fi
  log=$(mktemp)
  trap 'rm -rf "$log" "${new:-}"' EXIT
  target=${target:-$(setting target)}
  if [ -z "$target" ]; then
    target=$(python3 "$converter" "$project" --print-target 2>"$log") ||
      { sed 's/pass --target NAME/name one (graft build TARGET, or target: in graft.yml)/' "$log" >&2; exit 1; }
  fi
  adapters=$(setting adapters)
  dir=${adapters:-graft}/$target/$configuration
  convert_cmd="graft convert --configuration $configuration $target"

  # The converter's links are relative, so the scratch adapter is made beside $dir, at its depth.
  new=$(dirname "$dir")/.$configuration.new
  rm -rf "$new"
  mkdir -p "$(dirname "$dir")"
  if ! python3 "$converter" "$project" --target "$target" --configuration "$configuration" \
      --no-bsp --out "$new" >"$log" 2>&1; then
    cat "$log" >&2
    exit 1
  fi
  hash=$(tree_hash "$new")

  if [ -n "$convert_only" ]; then
    echo "== Adapter for $target ($configuration) of $project =="
    grep -v '^wrote ' "$log" || true
    # Only files that changed are copied over the adapter, and what builds write stays (the build
    # tree, Package.resolved), so the next build is incremental and the packages' versions stay.
    mkdir -p "$dir"
    rsync -rlpD --checksum --delete \
      --exclude /.build --exclude /.swiftpm --exclude /.bsp --exclude /xtool \
      --exclude /Package.resolved --exclude /.gitignore --exclude /.graft-converted \
      "$new/" "$dir/"
    [ -f "$dir/.gitignore" ] || printf '%s\n' .build/ .swiftpm/ .bsp/ xtool/ >"$dir/.gitignore"
    echo "$hash" >"$dir/.graft-converted"
    echo "Wrote $dir. Converting replaces edits to it: check git diff -- $dir, restore the edits"
    echo "still needed (git checkout -p -- $dir), and commit it."
    exit 0
  fi
  rm -rf "$new"
  if [ ! -f "$dir/.graft-converted" ]; then
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$dir")"
    echo "No adapter for $target ($configuration) in $dir. Make it with: $convert_cmd" >&2
    echo "then commit $dir." >&2
    exit 1
  fi
  if [ "$(cat "$dir/.graft-converted")" != "$hash" ]; then
    echo "The adapter in $dir is out of date: the converter's output for $target ($configuration)" >&2
    echo "changed since it was made. Make it again with: $convert_cmd" >&2
    echo "then check git diff -- $dir, restore the edits still needed, and commit it." >&2
    exit 1
  fi
fi

# ship.sh --device rather than xtool dev build: it puts the resources at the bundle root, where
# Bundle.main finds them, as Xcode lays an app out.
echo "== Build ($configuration) =="
(cd "$dir" && CONFIGURATION=$mode "$O/ship.sh" --device)
app=$(ls -dt "$dir"/xtool/*.app | head -n1)
app=${app#./}
echo "Built $app"
if [ -n "${GRAFT_APP_FILE:-}" ]; then realpath "$app" >"$GRAFT_APP_FILE"; fi
