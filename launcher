#!/usr/bin/env bash
# Launcher for graft (https://github.com/brandnewbox/graft): builds iOS apps on Linux in its
# container, and installs them on an iPhone or iPad over Tailscale. It runs on the host. The image carries it
# (/usr/local/share/graft/launcher) and the graft command runs it from there, so it updates
# with the image (README.md). Through that command:
#
#   graft setup XCODE.xip               once per machine (and per Xcode): pull the image, make the SDK
#   graft pair NAME TAILNET_IP FILE     once per device: import its pairing record, made on a Mac,
#                                       and add it to the devices as NAME (alone: how)
#   graft build [--configuration NAME | --release] [TARGET]
#                                       build the app in the current directory (graft-build)
#   graft deploy [--configuration NAME | --release] [--provision] [--device NAME] [TARGET | APP.app]
#                                       build, then sign, install and launch it on a device
#   graft devices [add NAME TAILNET_IP [UDID] [--port PORT] | default NAME | remove NAME]
#                                       list the devices, or change them (graft-devices)
#
# Run build and deploy at the project's root, which is mounted at the same path. The devices are in
# ~/.config/graft/devices. Settings, from the environment or ~/.config/graft/env:
#   ASC_KEY_ID, ASC_ISSUER_ID    an App Store Connect API key, for development signing, and either
#   ASC_KEY_COMMAND              a command that prints its .p8 (op read ..., gpg -d ...), run
#                                only when a deploy goes to App Store Connect, or
#   ASC_KEY_PATH                 the .p8 file itself
set -euo pipefail
image=${GRAFT_IMAGE:-ghcr.io/brandnewbox/graft:swift-6.4.1}
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/graft
config=$config_dir/env
if [ -f "$config" ]; then set -a; . "$config"; set +a; fi

run() { # [docker run options...] -- CMD...
  local opts=(--rm -i --network host --cap-add NET_ADMIN --device /dev/net/tun
    -v graft-state:/state -v graft-sdk:/sdk -v "$PWD:$PWD" -w "$PWD"
    -v "$config_dir:/graft" -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" -e ASC_KEY_ID -e ASC_ISSUER_ID)
  if [ -t 0 ] && [ -t 1 ]; then opts+=(-t); fi
  if [ -n "${ASC_KEY_PATH:-}" ]; then
    opts+=(-v "$(realpath "${ASC_KEY_PATH/#\~/$HOME}"):/asc/key.p8:ro" -e ASC_KEY_PATH=/asc/key.p8)
  fi
  while [ "$1" != -- ]; do opts+=("$1"); shift; done
  shift
  docker run "${opts[@]}" "$image" "$@"
}

mkdir -p "$config_dir"
case "${1:-}" in
setup)
  xip=$(realpath "${2:?usage: graft setup XCODE.xip}")
  [ -f "$xip" ] || { echo "no such file: $xip" >&2; exit 1; }
  docker pull "$image" || docker image inspect "$image" >/dev/null
  # Unpacking the .xip takes about 16 GB at its peak; the SDK is 3.4 GB after.
  free=$(df --output=avail -k "$(docker info -f '{{.DockerRootDir}}')" | tail -1)
  if [ "$free" -lt $((20 * 1024 * 1024)) ]; then
    echo "making the SDK needs 20 GB free for Docker, $((free / 1024 / 1024)) GB is" >&2
    exit 1
  fi
  run -v "$xip:/tmp/Xcode.xip:ro" -- setup-sdk /tmp/Xcode.xip
  ;;
pair)
  shift
  if [ $# = 3 ]; then
    file=$(realpath "$3")
    [ -f "$file" ] || { echo "no such file: $3" >&2; exit 1; }
    run -v "$file:/tmp/$(basename "$file"):ro" -- iphone-pair "$1" "$2" "/tmp/$(basename "$file")"
  else
    run -- iphone-pair "$@" # how to pair
  fi
  ;;
build)
  shift
  run -- graft-build "$@"
  ;;
devices)
  shift
  run -- graft-devices "$@"
  ;;
deploy)
  shift
  if [ -z "${ASC_KEY_COMMAND:-}" ]; then
    run -- graft-deploy "$@"
    exit
  fi
  # Without the key first: most deploys don't go to App Store Connect. When one has to (exit 75),
  # fetch the key into a file in memory and run again; the build is incremental by then.
  status=0
  ASC_KEY_PATH='' run -e GRAFT_KEY_ON_DEMAND=1 -- graft-deploy "$@" || status=$?
  if [ "$status" != 75 ]; then exit "$status"; fi
  key=$(mktemp -p "${XDG_RUNTIME_DIR:-/dev/shm}" asc-key.XXXXXX)
  trap 'rm -f "$key"' EXIT
  echo "== Fetching the App Store Connect key (ASC_KEY_COMMAND) ==" >&2
  sh -c "$ASC_KEY_COMMAND" >"$key"
  grep -q 'BEGIN PRIVATE KEY' "$key" || { echo "ASC_KEY_COMMAND didn't print a .p8 key" >&2; exit 1; }
  ASC_KEY_PATH=$key run -- graft-deploy "$@"
  ;;
*)
  cat >&2 <<'EOF'
usage: graft setup XCODE.xip
       graft pair NAME TAILNET_IP FILE
       graft build [--configuration NAME | --release] [TARGET]
       graft deploy [--configuration NAME | --release] [--provision] [--device NAME] [TARGET | APP.app]
       graft devices [add NAME TAILNET_IP [UDID] [--port PORT] | default NAME | remove NAME]
EOF
  exit 2
  ;;
esac
